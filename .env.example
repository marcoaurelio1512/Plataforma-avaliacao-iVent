# iVent NeoPed — Avaliação · variáveis de ambiente
# Copie para .env (desenvolvimento) ou cadastre no Railway (produção).
# NUNCA versione valores reais.

# --- Obrigatórias -----------------------------------------------------------
# PostgreSQL. No Railway, use a referência ${{Postgres.DATABASE_URL}}.
DATABASE_URL=postgresql://usuario:senha@localhost:5432/ivent_avaliacao

# Administrador inicial (criado no primeiro boot; não é sobrescrito depois).
ADMIN_EMAIL=admin@exemplo.com
# Mínimo 10 caracteres com letras e números. Obrigatória em produção.
ADMIN_PASSWORD=
ADMIN_NAME=Administrador

# Sal para anonimizar IPs (hash) em logs/limites. Obrigatório em produção (16+ caracteres).
# Gere com: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
IP_HASH_SALT=

# --- Recomendadas ------------------------------------------------------------
NODE_ENV=production
# URL pública usada nos links e QR Codes (ex.: https://avaliacao.seudominio.com.br).
# Sem ela, o link é montado a partir do endereço da requisição.
PUBLIC_BASE_URL=

# --- Opcionais ----------------------------------------------------------------
# PORT=8788                  # o Railway define automaticamente
# DATABASE_SSL=true          # padrão: true em produção para bancos remotos
# DATABASE_POOL_MAX=10
# SESSION_TTL_HOURS=12       # duração da sessão administrativa
# MIN_FILL_SECONDS=20        # tempo mínimo de preenchimento (antiautomação)
# TRUST_PROXY=true           # padrão em produção (Railway usa proxy)
# INITIAL_IVENT_VERSION=iVent 1.0
# ADMIN_RESET_PASSWORD=true  # redefine a senha do ADMIN_EMAIL no próximo boot (remova depois)

# --- Análise por IA (opcional) --------------------------------------------------
# Sem chave, todo o sistema funciona; apenas o módulo de IA fica indisponível.
# Opção 1 — Anthropic (padrão):
# ANTHROPIC_API_KEY=
# AI_MODEL=claude-opus-5-5
# Opção 2 — endpoint compatível com OpenAI:
# AI_PROVIDER=openai
# AI_API_KEY=
# AI_MODEL=
# AI_BASE_URL=https://api.openai.com/v1
