{
  "name": "ivent-neoped-avaliacao",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "iVent NeoPed — Avaliação: plataforma de questionários e análise de feedback",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm run api\" \"vite\"",
    "api": "node --env-file-if-exists=.env --import tsx --watch server/index.ts",
    "build": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.server.json && vite build",
    "start": "node --import tsx server/index.ts",
    "migrate": "node --env-file-if-exists=.env --import tsx server/scripts/migrate.ts",
    "seed": "node --env-file-if-exists=.env --import tsx server/scripts/seed.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.server.json",
    "backup": "sh scripts/backup.sh",
    "verify": "npm run typecheck && npm test && npm run build",
    "tutoriais": "node --import tsx scripts/tutoriais/gravar.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource/noto-sans": "^5.3.0",
    "@hono/node-server": "^2.1.4",
    "d3-cloud": "^1.2.9",
    "exceljs": "^4.4.0",
    "hono": "^4.13.13",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.54.0",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1",
    "tsx": "^4.23.15",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.0",
    "@types/d3-cloud": "^1.2.9",
    "@types/node": "^26.6.5",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
